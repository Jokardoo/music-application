<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="00--26-10-12--create-enum-music-genre" author="Барков Даниил">

        <preConditions onFail="HALT">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM pg_type WHERE typname = 'music_genre_enum'
            </sqlCheck>
        </preConditions>

        <sql>
            CREATE TYPE music_genre_enum AS ENUM (
                'CLASSICAL',
                'JAZZ',
                'BLUES',
                'ROCK',
                'ALTERNATIVE_ROCK',
                'PUNK',
                'METAL',
                'POP',
                'INDIE_POP',
                'K_POP',
                'LATIN_POP',
                'HIP_HOP',
                'HOUSE',
                'TECHNO',
                'TRANCE',
                'AMBIENT',
                'DUBSTEP',
                'DRUM_AND_BASS',
                'SYNTHWAVE',
                'DISCO_FUNK',
                'RNB_SOUL',
                'REGGAE',
                'LATIN',
                'FOLK',
                'AFRO',
                'ASIAN_TRADITIONAL',
                'GOSPEL',
                'SOUNDTRACK',
                'INSTRUMENTAL',
                'OTHER'
            );
        </sql>

        <rollback>
            DROP TYPE IF EXISTS music_genre_enum;
        </rollback>
    </changeSet>

</databaseChangeLog>