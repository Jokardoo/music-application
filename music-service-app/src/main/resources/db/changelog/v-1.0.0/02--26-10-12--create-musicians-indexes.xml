<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="02-create-musicians-indexes" author="Барков Даниил">

        <preConditions onFail="HALT">
            <tableExists tableName="musicians"/>
            <not>
                <indexExists indexName="idx_musicians_name" tableName="musicians"/>
            </not>
        </preConditions>

        <createIndex tableName="musicians" indexName="idx_musicians_name">
            <column name="name"/>
        </createIndex>

        <createIndex tableName="musicians" indexName="idx_musicians_country">
            <column name="country"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="musicians" indexName="idx_musicians_name"/>
            <dropIndex tableName="musicians" indexName="idx_musicians_country"/>
        </rollback>
    </changeSet>

</databaseChangeLog>