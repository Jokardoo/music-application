<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="01-create-musicians-table" author="Барков Даниил">

        <preConditions onFail="HALT">
            <not>
                <tableExists tableName="musicians"/>
            </not>
        </preConditions>

        <createTable tableName="musicians">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_musicians"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="country" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>

            <column name="formed_year" type="INTEGER"/>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <column name="image_url" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>

            <column name="short_description" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="musicians"/>
        </rollback>

    </changeSet>

</databaseChangeLog>