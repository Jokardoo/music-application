<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="03--26-10-12--create-songs-table" author="Барков Даниил">

        <preConditions onFail="HALT">
            <not>
                <tableExists tableName="songs"/>
            </not>
            <tableExists tableName="musicians"/>
            <sqlCheck expectedResult="1">
                SELECT count(*) FROM pg_type WHERE typname = 'music_genre_enum'
            </sqlCheck>
        </preConditions>

        <createTable tableName="songs">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true"
                             nullable="false"
                             primaryKeyName="pk_songs"/>
            </column>

            <column name="musician_name" type="VARCHAR(100)">
                <constraints nullable="false"
                             foreignKeyName="fk_songs_musician"
                             references="musicians(name)"/>
            </column>

            <column name="song_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="music_genre" type="music_genre_enum">
                <constraints nullable="false"/>
            </column>

            <column name="duration_seconds" type="INTEGER">
                <constraints nullable="true"/>
            </column>

            <column name="release_date" type="DATE">
                <constraints nullable="true"/>
            </column>

            <column name="album_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="songs"/>
        </rollback>

    </changeSet>

</databaseChangeLog>